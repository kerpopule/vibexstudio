{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VibeXStudio",
  "version": "1.2.0",
  "identifier": "studio.vibex.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8098"
  },
  "app": {
    "windows": [
      {
        "title": "VibeX Studio",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "hardenedRuntime": true
    },
    "resources": {
      "../workbench/server.mjs": "workbench/server.mjs",
      "resources/media-lab": "media-lab"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kerpopule/vibexstudio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNzIyRTRCNkI3QzE4RjYKUldUMkdIeHJTeTV5Z0labi95MWpLTGh2MHJsZ2hzazhjeFpHWXBXUVVhN0VlVFNtVVEwU3UrajIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
