{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VibeXStudio",
  "version": "0.1.0",
  "identifier": "studio.vibex.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8098"
  },
  "app": {
    "windows": [
      {
        "title": "VibeX Studio",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "hardenedRuntime": true
    }
  }
}