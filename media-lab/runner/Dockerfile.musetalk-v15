FROM nvcr.io/nvidia/pytorch:25.12-py3

ARG MUSETALK_REVISION=0a89dec45a0192b824e3cf4daf96c239440c5ed8
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/TMElyralab/MuseTalk.git /opt/MuseTalk && \
    cd /opt/MuseTalk && \
    git checkout --detach "${MUSETALK_REVISION}"

# Inference-only dependency set. Keep NVIDIA's Spark-compatible torch/torchvision.
RUN python -m pip install --no-cache-dir numpy==1.26.4
RUN python -m pip install --no-cache-dir --no-build-isolation \
      diffusers==0.30.2 accelerate==0.28.0 \
      opencv-python==4.9.0.80 soundfile==0.12.1 transformers==4.39.2 \
      huggingface_hub==0.30.2 librosa==0.11.0 einops==0.8.1 \
      gdown requests 'imageio[ffmpeg]' omegaconf ffmpeg-python moviepy \
      mmengine==0.10.7 mmcv-lite==2.1.0 mmdet==3.3.0 mmpose==1.3.2 \
      xtcocotools==1.14.3 chumpy==0.70 json-tricks==3.17.3

COPY runner/musetalk_preprocessing_opencv.py /opt/MuseTalk/musetalk/utils/preprocessing.py
COPY runner/musetalk_torchload_patch.py /tmp/musetalk_torchload_patch.py
RUN python /tmp/musetalk_torchload_patch.py && rm /tmp/musetalk_torchload_patch.py

WORKDIR /opt/MuseTalk
ENTRYPOINT ["python3", "-m", "scripts.inference"]
