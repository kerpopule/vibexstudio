{
  "schema_version": 1,
  "version": "2026-08-19",
  "slots": {
    "language": {
      "allowed": ["qwen", "deepseek-full"],
      "primary": "qwen",
      "note": "deepseek-full is mutually-exclusive and drains media; refused here when measured floors fail."
    },
    "video": {
      "allowed": ["ltx", "h3"],
      "primary": "ltx",
      "note": "h3 is the alternate video; co-resident dual-video (ltx+h3) is refused on GB10 when warm phases exceed the pool."
    },
    "image": {
      "allowed": ["flux"],
      "primary": "flux"
    },
    "speech": {
      "allowed": ["voicebox"],
      "primary": "voicebox"
    },
    "segmentation": {
      "allowed": ["sam3"],
      "primary": "sam3"
    }
  },
  "constraints": [
    "no-remote-code-execution",
    "residency-and-concurrency-are-separate",
    "busy-services-drain-not-kill",
    "explicit-pinned-priority-overrides-defaults",
    "grey-headroom-is-uncommitted-not-optimistic"
  ]
}