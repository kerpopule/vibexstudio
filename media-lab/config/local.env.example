# Media Lab per-host settings.
#
#   cp config/local.env.example ~/media-lab-simple/config/local.env
#
# config/local.env is gitignored: it is the ONE place a machine's hostnames,
# tailnet address and model/runtime paths live. A studio's own looks, templates,
# character catalog and assistant notes go in the gitignored folder
# config/local/ next to it (docs/LOCAL-OVERLAY.md). Nothing in the tracked tree
# names a specific machine (tools/identity_guard.py enforces that in CI).
#
# Read by media_lab_core/local_config.py (app.py and the runner .py files),
# sourced by the runner shell scripts, and loaded by the systemd units through
# EnvironmentFile=. Plain KEY=VALUE; ~ is expanded; process env overrides.
# `python -m media_lab_core.local_config` prints what resolves on this host.

# Data root: jobs.json, media/, pool/, this file. Keep the default unless
# ./install.sh was pointed elsewhere (it leaves a symlink at ~/media-lab-simple).
MEDIA_LAB_HOME=~/media-lab-simple

# Address uvicorn and the sidecars (:7864 Advanced mode, :8003/:8004 text) bind.
# 127.0.0.1 = this machine only. A tailnet address makes the studio reachable
# from paired phones/desktops; the bind-readiness drop-in waits for it at boot.
MEDIA_LAB_BIND_HOST=127.0.0.1

# Browser origins allowed to call the API cross-origin (the VibeX Studio web
# build / dev server). The desktop app's Tauri origins are always allowed;
# phones and tablets need nothing here. Exact origins, comma separated.
MEDIA_LAB_BROWSER_ORIGINS=

# Lock files shared by every GPU consumer. Default: the per-user runtime dir
# (XDG_RUNTIME_DIR, else /run/user/<uid>, else the temp dir).
MEDIA_LAB_INFERENCE_LOCK=
MEDIA_LAB_GPU_LOCK=

# Hostnames your tunnel / reverse proxy presents, comma separated. Requests on
# these hosts are treated as public-edge traffic (Secure cookies, edge IP).
MEDIA_LAB_PUBLIC_HOSTS=

# Engine weights (HunyuanVideo-Avatar, MuseTalk, ...) and engine runtimes
# (LatentSync.stage, comfy-ltx25, music3-iso, ...).
MEDIA_LAB_MODELS_ROOT=~/.local/share/media-lab-p2-models
MEDIA_LAB_RUNTIME_ROOT=~/runtime

# This machine's tailnet IP or MagicDNS name, if it has one. Trusted like
# localhost. Leave empty on a laptop that is not on a tailnet.
MEDIA_LAB_TAILNET_HOST=

# OpenAI-compatible text runtime the studio talks to (PPLX / Flash-Next).
MEDIA_LAB_TEXT_UPSTREAM=http://127.0.0.1:8004

# Optional, Mac-side helpers only (local_studio.py, tools/topaz_worker.py):
# ssh target of the studio host, e.g. user@studio-host. Empty disables them.
MEDIA_LAB_SSH=

# Memory planning: GB the resident text model takes (0 = served remotely via
# the bridge, nothing resident) and the unified-memory ceiling app.py plans
# video engines against.
MEDIA_LAB_QWEN_GB=0
MEDIA_LAB_MEM_CAP_GB=120

# H3 → LTX 2.5 composite route. LTX native-retake strength is clamped to
# 0.01..1.0; 0.35 preserves H3 identity/motion while applying a visible polish.
MEDIA_LAB_H3_LTX_RETAKE_STRENGTH=0.35

# Always-warm H3, used when the idle residency profile includes h3 (qwen-h3).
# The idle preload boots this Sol task: t2va (text-only, what nearly every H3
# job uses, so it is reused without a reload) or fl2va (first/last frame).
# After other GPU work pushes H3 out, it is reloaded once no local GPU job
# has finished for MEDIA_LAB_H3_RESTORE_QUIET_S seconds; a queued H3 take
# waits behind that other work for at most MEDIA_LAB_H3_BATCH_MAX_WAIT_S.
# Every H3 cold load first waits (at most ..._SETTLE_MAX_WAIT_S seconds) for
# memory pressure <= ..._SETTLE_MAX_PSI and a steady MemAvailable.
MEDIA_LAB_H3_IDLE_TASK=t2va
MEDIA_LAB_H3_RESTORE_QUIET_S=300
MEDIA_LAB_H3_BATCH_MAX_WAIT_S=900
MEDIA_LAB_H3_LOAD_SETTLE_MAX_PSI=2
MEDIA_LAB_H3_LOAD_SETTLE_MAX_WAIT_S=120

# Sol-H3-Spark — the whole-box H3 video engine (runner/sol_engine_server.py).
# SOL_ROOT/envs/stage2/bin/python runs the server; app.py starts it as the
# transient user unit media-lab-sol-h3.service on :8291.
# SOL_PKG empty = not installed on this host; the h3 engine is then unavailable.
SOL_PKG=
SOL_ROOT=~/.local/share/sol-h3-spark
SOL_H3_SPARK_RUNTIME_ROOT=~/.local/share/sol-h3-spark/runtime
SOL_H3_SPARK_QWEN_WEIGHTS_ROOT=~/.local/share
SOL_H3_SPARK_QWEN_IMAGE=sol-h3-spark-qwen

# YuE2 — the primary music engine (runner/yue2_engine_server.py), started by
# app.py as the transient user unit media-lab-yue2.service. YUE2_KIT is the
# isolated kit: .venv (torch + yue2), the YuE checkout, .venv-sheetsage for
# transcription. YUE2_MODELS_ROOT holds YuE2-3B, YuE2-Vae, SheetSage2 and
# MERT-v2-FullSong. Weights are CC BY-NC 4.0: non-commercial use only.
YUE2_KIT=~/runtime/yue2-iso
YUE2_MODELS_ROOT=~/.local/share/media-lab-p3-models/yue2
YUE2_PORT=8197

# Mel-Band RoFormer vocal/instrumental separator (song stems):
# <root>/.venv/bin/melband-roformer-infer with weights under <root>/models.
MELBAND_ROFORMER_ROOT=~/runtime/melband-roformer-0.1.5
MELBAND_ROFORMER_MODEL=melband-roformer-kim-vocals

# Engines whose model licence is personal / non-commercial / restricted stay
# OFF until this host names them here (docs/ENGINE-LICENCES.md): a comma list
# of h3, yue2, kontext, qwen-image-21, hunyuan-avatar -- or "all". The studio
# shows them greyed out with a "personal / non-commercial" badge otherwise.
# Only enable an engine if your use (and location) fits its licence.
MEDIA_LAB_PERSONAL_ENGINES=

# Web-push contact announced to the push services (the VAPID "sub" claim):
# mailto:you@example.com or an https:// URL. Empty = the project's public page.
MEDIA_LAB_VAPID_SUBJECT=

# Character names whose cast jobs get the director's likeness-qualification
# framing (large faces, restrained expression). Comma separated; empty = none.
MEDIA_LAB_QUALIFICATION_CAST=
